HOST=127.0.0.1
PORT=3001
SERVICE_URL=http://127.0.0.1:3001
NODE_ENV=development
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key
# Main generative model for complex requests and decision verification.
MODEL=your-model-name
# Decision model for Guard, Router and complexity (uses Decisions API).
MODEL_FAST=typesafe/jev-1.13
# Optional generative model for simple requests and final Action responses.
# When omitted, MODEL is used. Jev cannot generate these responses.
# MODEL_SIMPLE=your-simple-chat-model
DECISION_CONFIDENCE_THRESHOLD=0.7
# Optional server-only Telegram notifications for new visitors.
TG_NOTIFY_BOT_TOKEN=
TG_NOTIFY_BOT_CHAT=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REQUEST_DEADLINE_MS=60000
LLM_TIMEOUT_MS=20000
ACK_TIMEOUT_MS=5000
MAX_CONCURRENT_RUNS=8
MAX_LLM_CALLS=8
MAX_TOOL_CALLS=12
MAX_OUTPUT_TOKENS=1500
