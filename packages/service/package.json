{
  "name": "@shop/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:fastify '--external:@langchain/*' --external:ws --external:@fastify/websocket --external:zod --outfile=dist/index.mjs",
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.mjs"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.4",
    "@langchain/core": "1.3.4",
    "@langchain/langgraph": "1.6.0",
    "@langchain/openrouter": "0.4.21",
    "@shop/shared": "workspace:*",
    "fastify": "5.12.7",
    "ws": "8.21.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
