{
  "name": "ai-shopping-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn build && yarn dev:watch",
    "dev:watch": "yarn workspace @shop/web dev & yarn workspace @shop/server dev & NODE_ENV=development node --watch --env-file-if-exists=.env packages/service/dist/index.mjs",
    "build": "yarn workspace @shop/web build && yarn workspace @shop/server build",
    "start": "node --env-file-if-exists=.env packages/service/dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval:fake": "node --import tsx tests/evals/run-evals.ts",
    "eval:live": "node --env-file-if-exists=.env --import tsx tests/evals/run-evals.ts --live",
    "check": "yarn typecheck && yarn lint && yarn test && yarn build",
    "dev:fake": "LLM_PROVIDER=fake yarn dev"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
